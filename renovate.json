{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "These eight workflows are generated by Vaskeladden/uptime-monitor and checked by status-source.yml. Update their dependencies in the generator, then regenerate; keep status-source.yml eligible for Renovate.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/graphs.yml",
        ".github/workflows/response-time.yml",
        ".github/workflows/setup.yml",
        ".github/workflows/site.yml",
        ".github/workflows/summary.yml",
        ".github/workflows/update-template.yml",
        ".github/workflows/updates.yml",
        ".github/workflows/uptime.yml"
      ],
      "enabled": false
    },
    {
      "description": "One grouped PR for all non-major updates — auto-merges without the app owner doing anything",
      "groupName": "dependencies (non-major)",
      "groupSlug": "deps-nonmajor",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "description": "Major updates: one PR each, still automerge, labeled so they are easy to spot",
      "labels": [
        "dependencies",
        "major"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 9am on monday"
  ],
  "timezone": "Europe/Oslo",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": "0 days"
  }
}
