{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "mode": "full",
  "forkProcessing": "enabled",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "internalChecksAsSuccess": true,
  "ignoreTests": false,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "1 hour"
  },
  "npmrc": "allow-remote=all",
  "npmrcMerge": true,
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "timezone": "Europe/Oslo",
  "packageRules": [
    {
      "matchRepositories": [
        "Vaskeladden/status"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-node"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchJsonata": [
        "$exists(managerData.npmLock) or ($not($exists(managerData.pnpmLockFile)) and $not($exists(managerData.yarnLock)))"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
